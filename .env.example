# Copy to .env for local development against the local Tiro EHR stack. Never commit .env.
SMART_CLIENT_ID=dev-smart-app
# The dev client's private key, one line of JSON, from the EHR repo:
# .local-stack/smart-dev-client/private.jwk.json
SMART_PRIVATE_JWK=
SMART_ISS=http://localhost:8090/t/
APP_URL=http://localhost:3001
# At least 32 random characters, e.g. the output of: openssl rand -hex 32
SESSION_SECRET=
