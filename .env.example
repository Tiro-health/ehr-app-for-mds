# Copy to .env to open the app from the local Tiro EHR stack while developing. Never commit .env.
#
# The SMART sign-in is not part of this app: Tiro's auth proxy does it. Run it locally from
# Tiro-health/ehr-app-manager, with the EHR's dev client (from the EHR repo):
#
#   cd auth-proxy && PORT=8787 DEV_APP_URL=http://localhost:3001 DEV_CLIENT_ID=dev-smart-app \
#     DEV_PRIVATE_JWK_FILE=<ehr>/.local-stack/smart-dev-client/private.jwk.json \
#     SMART_ISS=http://localhost:8090/t/ pnpm dev
#
# and register the dev client's launch URL in the EHR as http://localhost:3001/_tiro/auth/launch.
TIRO_AUTH_URL=http://localhost:8787
